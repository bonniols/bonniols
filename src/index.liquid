---
title: Home
layout: layouts/base.liquid
hasHomeHero: true
---
<div class="container-wide py-8 md:py-12">
    {% if homeGalleryItems.size > 0 %}
        <script type="application/json" id="home-gallery-data">
            {{ homeGalleryItems | json }}
        </script>
        {% if homeGalleryUrl != '' %}
            <a
                href="{{ homeGalleryUrl }}"
                target="_blank"
                rel="noopener noreferrer"
                data-home-hero
            >
                <figure hidden>
                    <img
                        src=""
                        alt=""
                        class="w-full"
                    >
                    <figcaption hidden class="pt-2 leading-tight italic no-underline"></figcaption>
                </figure>
            </a>
        {% else %}
            <div data-home-hero>
                <figure hidden>
                    <img
                        src=""
                        alt=""
                        class="w-full"
                    >
                    <figcaption hidden class="pt-2 leading-tight italic no-underline"></figcaption>
                </figure>
            </div>
        {% endif %}
    {% endif %}
</div>
