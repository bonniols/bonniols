---
title: Home
layout: layouts/base.liquid
hasHomeHero: true
---
<div class="container-wide py-12">
    {% if homeGalleryItems.size > 0 %}
        <script type="application/json" id="home-gallery-data">
            {{ homeGalleryItems | json }}
        </script>
        <figure
            data-home-hero
            hidden
        >
            <img
                src=""
                alt=""
                class="w-full"
            >
            <figcaption hidden></figcaption>
        </figure>
    {% endif %}
</div>
