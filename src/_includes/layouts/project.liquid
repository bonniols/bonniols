---
layout: layouts/base.liquid
---
<article class="grow">
    <header class="container-wide flex items-center justify-between py-8 md:py-12">
        <h1 class="text-xl font-bold">{{ title }}</h1>
        <a href="#infos" class="hidden text-xl md:block">Infos</a>
    </header>
    {% if galleryItems and galleryItems.size > 0 %}
        <section
            class="gallery container-wide my-8"
            aria-label="Galerie photos"
            data-gallery
            data-slide-count="{{ galleryItems.size }}"
        >
            {% render 'partials/gallery-grid', galleryItems: galleryItems %}
            {% render 'partials/gallery-swiper', galleryItems: galleryItems %}
        </section>
    {% endif %}
    <section
        id="infos"
        class="container-regular mb-8 py-8 md:mb-12 md:py-12"
        aria-labelledby="project-title"
    >
        <h2 class="mb-4 text-lg font-bold">Infos</h2>
        <div class="space-y-4 text-neutral-800 [&_a]:text-blue-700 [&_a]:underline">
            {{ content }}
        </div>
    </section>
</article>
