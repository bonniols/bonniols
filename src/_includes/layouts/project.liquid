---
layout: layouts/base.liquid
---
<article class="grow">
    <header class="container-wide flex items-center justify-between py-8 md:py-12">
        <h1>{{ title }}</h1>
        {% if text_labels.project_infos_label != blank %}
            <a href="#infos" class="project-infos-link hidden text-xl md:block">
                {{- text_labels.project_infos_label -}}
            </a>
        {% endif %}
    </header>
    {% if galleryItems and galleryItems.size > 0 %}
        <section
            class="gallery container-wide mb-8"
            aria-label="Galerie photos"
            data-gallery
            data-slide-count="{{ galleryItems.size }}"
        >
            {% render 'partials/gallery-grid', galleryItems: galleryItems %}
            {% render 'partials/gallery-swiper',
                galleryItems: galleryItems,
                invert_text_color: invert_text_color,
                background_color: background_color,
                use_background_color_in_slider: use_background_color_in_slider
            %}
        </section>
    {% endif %}
    <section
        id="infos"
        class="container-regular mb-8 scroll-mt-16 py-8 md:mb-12 md:py-12"
        aria-labelledby="project-title"
    >
        <div class="content-body">
            {{ content }}
        </div>
    </section>
</article>
