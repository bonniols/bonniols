---
layout: layouts/base.liquid
---
<article class="grow">
    <header class="container-wide flex flex-col items-start gap-1 py-8 md:flex-row md:items-center md:justify-between md:gap-4 md:py-12">
        <h1>{{ title }}</h1>
        <div class="flex w-full items-baseline justify-between gap-4 md:w-auto">
            {% if text_labels.project_infos_label != blank %}
                <a href="#infos" class="project-infos-link text-base md:text-xl">
                    {{- text_labels.project_infos_label -}}
                </a>
            {% endif %}
            {% if galleryItems and galleryItems.size > 0 %}
                {% comment %} Mobile-only slider pagination, wired up in gallery.js {% endcomment %}
                <div
                    class="swiper-pagination relative! inset-auto! ml-auto w-auto! text-sm! opacity-65 md:hidden"
                    data-gallery-pagination
                ></div>
            {% endif %}
        </div>
    </header>
    {% if galleryItems and galleryItems.size > 0 %}
        <section
            class="gallery container-wide"
            aria-label="Galerie photos"
            data-gallery
            data-slide-count="{{ galleryItems.size }}"
        >
            {% render 'partials/gallery-grid', galleryItems: galleryItems %}
            {% render 'partials/gallery-swiper',
                galleryItems: galleryItems,
                invert_text_color: invert_text_color,
                background_color: background_color,
                use_background_color_in_slider: use_background_color_in_slider
            %}
        </section>
    {% endif %}
    <section
        id="infos"
        class="container-regular mb-8 scroll-mt-16 py-8 md:mb-12 md:py-12"
        aria-labelledby="project-title"
    >
        <div class="content-body">
            {{ content }}
        </div>
    </section>
</article>
