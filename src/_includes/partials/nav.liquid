{% assign navPages = collections.all | eleventyNavigation %}

<header
  class="sticky top-0 z-30 flex items-center justify-between px-4 py-4 border-b border-neutral-200"
  style="background-color: {{ background_color | default: '#ffffff' }}"
  data-nav-header
>
  <a href="/" class="text-lg font-semibold tracking-tight hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 rounded-sm">
    Sylvain Bonniol
  </a>

  <nav class="hidden md:block" aria-label="Navigation principale">
    <ul class="flex items-center gap-1" role="menubar">
      {% for item in navPages %}
        {% render 'partials/nav-item', item: item, variant: 'desktop', depth: 0, page: page %}
      {% endfor %}
    </ul>
  </nav>

  <button
    type="button"
    class="md:hidden inline-flex items-center justify-center p-2 rounded-md hover:bg-neutral-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400"
    aria-expanded="false"
    aria-controls="nav-drawer"
    aria-label="Ouvrir le menu"
    data-nav-toggle
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </button>
</header>

<div
  class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 z-40 md:hidden"
  aria-hidden="true"
  data-nav-backdrop
></div>

<nav
  id="nav-drawer"
  class="fixed inset-y-0 right-0 w-full max-w-xs bg-white shadow-xl translate-x-full transition-transform duration-300 z-50 md:hidden flex flex-col"
  aria-label="Navigation mobile"
  aria-hidden="true"
  data-nav-drawer
>
  <div class="flex items-center justify-between p-4 border-b border-neutral-200">
    <span class="font-semibold">Menu</span>
    <button
      type="button"
      class="inline-flex items-center justify-center p-2 rounded-md hover:bg-neutral-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400"
      aria-label="Fermer le menu"
      data-nav-close
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <ul class="flex-1 overflow-y-auto p-4 space-y-1">
    {% for item in navPages %}
      {% render 'partials/nav-item', item: item, variant: 'mobile', depth: 0, page: page %}
    {% endfor %}
  </ul>
</nav>
