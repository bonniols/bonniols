{% assign navPages = collections.all | eleventyNavigation %}

<header class="sticky top-0 z-30 bg-white" data-nav-header>
    <div class="container-wide flex items-center justify-between py-4">
        <a
            href="/"
            class="font-serif text-lg font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400"
        >
            Sylvain Bonniol
        </a>

        <nav class="hidden md:block" aria-label="Navigation principale">
            <ul class="flex items-center gap-1" role="menubar">
                {% for item in navPages %}
                    {% render 'partials/nav-item',
                        item: item,
                        variant: 'desktop',
                        depth: 0,
                        page: page
                    %}
                {% endfor %}
            </ul>
        </nav>

        <button
            type="button"
            class="inline-flex items-center justify-center p-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 md:hidden"
            aria-expanded="false"
            aria-controls="nav-drawer"
            aria-label="Ouvrir le menu"
            data-nav-open
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-6"
            >
                <path fill-rule="evenodd" d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75ZM3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Zm0 5.25a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
            </svg>
        </button>
    </div>
</header>

<nav
    id="nav-drawer"
    class="fixed inset-y-0 right-0 z-50 flex w-full translate-x-full flex-col bg-white shadow-xl transition-transform duration-300 md:hidden"
    aria-label="Navigation mobile"
    aria-hidden="true"
    data-nav-drawer
>
    <div class="flex items-center justify-between p-4">
        <a
            href="/"
            class="font-serif text-lg font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400"
        >
            Sylvain Bonniol
        </a>
        <button
            type="button"
            class="inline-flex items-center justify-center p-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400"
            aria-label="Fermer le menu"
            data-nav-close
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-6"
            >
                <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
        </button>
    </div>
    <ul class="flex-1 space-y-1 overflow-y-auto p-4">
        {% for item in navPages %}
            {% render 'partials/nav-item', item: item, variant: 'mobile', depth: 0, page: page %}
        {% endfor %}
    </ul>
</nav>
