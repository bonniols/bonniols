{% if invert_text_color %}
    {% assign galleryTheme = 'gallery-swiper--inverted' %}
{% else %}
    {% assign galleryTheme = 'gallery-swiper--default' %}
{% endif %}
{% if use_background_color_in_slider %}
    {% assign sliderBg = background_color | default: '#3a3836' %}
{% else %}
    {% assign sliderBg = '#3a3836' %}
{% endif %}
<div
    class="gallery-swiper {{ galleryTheme }} block md:absolute md:inset-0 md:z-50 md:hidden md:h-dvh md:w-dvw md:items-center md:p-6"
    style="--gallery-swiper-bg: {{ sliderBg }}"
    data-gallery-swiper
    role="dialog"
    aria-modal="false"
    aria-label="Galerie photos"
    aria-hidden="false"
>
    <div class="absolute top-6 right-6 z-20 flex items-center gap-2">
        <button
            type="button"
            class="gallery-swiper__fullscreen hidden cursor-pointer items-center justify-center p-1 md:inline-flex"
            data-gallery-fullscreen
            aria-label="Plein écran"
            aria-pressed="false"
        >
            <svg
                class="gallery-swiper__icon-enter"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
            </svg>
            <svg
                class="gallery-swiper__icon-exit"
                hidden
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path>
            </svg>
        </button>
        <button
            type="button"
            class="gallery-swiper__close inline-flex cursor-pointer items-center justify-center px-3 py-1"
            data-gallery-close
            aria-label="Fermer la galerie"
        >
            <span>Fermer</span>
        </button>
    </div>

    <div class="swiper relative z-10 md:h-full md:w-full">
        <div class="swiper-wrapper">
            {% for item in galleryItems %}
                {% render 'partials/gallery-slide',
                    item: item,
                    sizes: '(max-width: 767px) 100vw, 90vw'
                %}
            {% endfor %}
        </div>

        <button
            type="button"
            class="swiper-button-prev h-20! w-14! py-6"
            aria-label="Image précédente"
        ></button>
        <button
            type="button"
            class="swiper-button-next h-20! w-14! py-6"
            aria-label="Image suivante"
        ></button>

        <div
            class="swiper-pagination relative! inset-auto! mt-2 w-auto text-left! font-black!"
        ></div>
    </div>
</div>
