<div
    class="gallery-swiper block md:absolute md:inset-0 md:z-50 md:flex md:hidden md:h-dvh md:w-dvw md:items-center md:bg-neutral-100/90 md:p-6"
    data-gallery-swiper
    role="dialog"
    aria-modal="false"
    aria-label="Galerie photos"
    aria-hidden="false"
>
    <button
        type="button"
        class="gallery-swiper__close absolute top-6 right-6 z-20 inline-flex cursor-pointer items-center justify-center bg-neutral-50/80 px-3 py-1 text-neutral-900"
        data-gallery-close
        aria-label="Fermer la galerie"
    >
        <span>Fermer</span>
    </button>

    <div class="swiper relative z-10 md:h-full md:w-full">
        <div class="swiper-wrapper">
            {% for item in galleryItems %}
                {% render 'partials/gallery-slide',
                    item: item,
                    sizes: '(max-width: 767px) 100vw, 90vw'
                %}
            {% endfor %}
        </div>

        <button
            type="button"
            class="swiper-button-prev h-20! w-14! bg-neutral-50/80 py-6 max-md:hidden"
            aria-label="Image précédente"
        ></button>
        <button
            type="button"
            class="swiper-button-next h-20! w-14! bg-neutral-50/80 py-6 max-md:hidden"
            aria-label="Image suivante"
        ></button>
    </div>
</div>
