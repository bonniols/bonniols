<div
    class="gallery-lightbox fixed inset-0 z-50 hidden"
    data-gallery-lightbox
    role="dialog"
    aria-modal="true"
    aria-label="Galerie photos"
    aria-hidden="true"
    data-autoplay="{{ site.gallery_autoplay | default: true }}"
    data-autoplay-delay="{{ site.gallery_autoplay_delay | default: 5 }}"
>
    <div
        class="gallery-lightbox__backdrop absolute inset-0 bg-black/90"
        data-gallery-backdrop
    ></div>

    <button
        type="button"
        class="gallery-lightbox__close"
        data-gallery-close
        aria-label="Fermer la galerie"
    >
        <svg
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
        >
            <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
    </button>

    <div class="gallery-lightbox__swiper swiper">
        <div class="swiper-wrapper">
            {% for item in galleryItems %}
                <div class="swiper-slide">
                    <div class="swiper-zoom-container">
                        <img
                            src="{{ item.lightboxSrc }}"
                            srcset="{{ item.srcset }}"
                            sizes="100vw"
                            alt="{{ item.caption | default: '' }}"
                        >
                    </div>
                    {% if item.caption != '' %}
                        <p class="gallery-lightbox__caption">{{ item.caption }}</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        <button
            type="button"
            class="swiper-button-prev gallery-lightbox__nav gallery-lightbox__nav--prev"
            aria-label="Image précédente"
        ></button>
        <button
            type="button"
            class="swiper-button-next gallery-lightbox__nav gallery-lightbox__nav--next"
            aria-label="Image suivante"
        ></button>
    </div>

    <button
        type="button"
        class="gallery-lightbox__play"
        data-gallery-play
        aria-pressed="false"
        aria-label="Lecture"
    >
        <svg
            class="gallery-lightbox__icon-play h-6 w-6"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
        >
            <path d="M8 5v14l11-7z" />
        </svg>
        <svg
            class="gallery-lightbox__icon-pause hidden h-6 w-6"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
        >
            <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" />
        </svg>
    </button>
</div>
