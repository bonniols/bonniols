{
    "$schema": "https://json.schemastore.org/prettierrc.json",
    "printWidth": 100,
    "tabWidth": 4,
    "singleQuote": true,
    "plugins": [
      "@shopify/prettier-plugin-liquid",
      "prettier-plugin-tailwindcss"
    ],
    "overrides": [
      {
        "files": ["**/*.liquid"],
        "options": {
          "singleQuote": false,
          "liquidSingleQuote": true
        }
      }
    ]
  }